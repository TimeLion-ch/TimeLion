# The webspace's document root is the app root and can't be changed, so every request is rewritten into public/.
# Nothing outside public/ (config.php, src/, vendor/, var/ …) is reachable from the web. public/.htaccess takes
# over from there. If the document root ever points to public/ directly, Apache ignores this file.
#
# No <IfModule mod_rewrite.c>: without mod_rewrite Apache answers 500 instead of serving the app root.

Options -Indexes

RewriteEngine On

# Files the host puts into .well-known/ are served as they are, e.g. the Let's Encrypt challenges for the
# HTTPS certificate. Everything else in .well-known/ comes from public/.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^\.well-known/ - [L]

# HTTPS redirect here, not only in public/.htaccess: after the rewrite below, %{REQUEST_URI} would be /public/….
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# public/.htaccess replaces these rules for everything under public/. This line only prevents a rewrite loop
# while public/.htaccess is missing, for example during the first upload.
RewriteRule ^public/ - [L]

RewriteRule ^(.*)$ public/$1 [L]
