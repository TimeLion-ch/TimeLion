{
	"name": "timelion-frontend",
	"version": "1.0.0",
	"private": true,
	"license": "AGPL-3.0-only",
	"type": "module",
	"engines": {
		"node": "^22.12.0 || >=24.0.0"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build && node scripts/build-public.mjs",
		"check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p tsconfig.node.json && tsc -p e2e/tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"e2e": "npm run build && playwright test",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"verify": "npm run format:check && npm run check && npm run test && npm run build"
	},
	"dependencies": {
		"svelte": "^5.57.2"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^24.19.2",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^3.5.2",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.3",
		"vite": "^8.3.4",
		"vite-plugin-singlefile": "^2.3.4",
		"vitest": "^5.0.5"
	}
}
